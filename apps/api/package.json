{
  "name": "@padel/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "migrate": "tsx --env-file-if-exists=.env src/migrate-cli.ts",
    "seed": "tsx --env-file-if-exists=.env src/seed-cli.ts",
    "demo": "tsx --env-file-if-exists=.env src/demo-cli.ts",
    "import-registrations": "tsx --env-file-if-exists=.env src/import-cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@padel/domain": "workspace:*",
    "fastify": "^5.12.0",
    "pg": "^8.23.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
